# Turkish Profile

tagaxis pos {
  role: classificatory
  display: { en: "Part of Speech" }
  index: exact
}

tagaxis tense {
  role: inflectional
  display: { en: "Tense" }
}

tagaxis person {
  role: inflectional
  display: { en: "Person" }
}

tagaxis number {
  role: inflectional
  display: { en: "Number" }
}

tagaxis negation {
  role: inflectional
  display: { en: "Negation" }
}

tagaxis case {
  role: inflectional
  display: { en: "Case" }
}

@extend pos_values for tagaxis pos {
  verb { display: { en: "Verb" } }
  noun { display: { en: "Noun" } }
}

@extend tense_values for tagaxis tense {
  present_cont { display: { en: "Present Continuous" } }
  past         { display: { en: "Past" } }
}

@extend person_values for tagaxis person {
  1 { display: { en: "1st" } }
  2 { display: { en: "2nd" } }
  3 { display: { en: "3rd" } }
}

@extend number_values for tagaxis number {
  sg { display: { en: "Singular" } }
  pl { display: { en: "Plural" } }
}

@extend negation_values for tagaxis negation {
  pos { display: { en: "Positive" } }
  neg { display: { en: "Negative" } }
}

@extend case_values for tagaxis case {
  nom { display: { en: "Nominative" } }
  acc { display: { en: "Accusative" } }
  dat { display: { en: "Dative" } }
  gen { display: { en: "Genitive" } }
  loc { display: { en: "Locative" } }
  abl { display: { en: "Ablative" } }
}

# ---------------------------------------------------------------------------
# Phonological rules
# ---------------------------------------------------------------------------

# Vowel harmony (2-way for low vowels, 4-way for high vowels)
phonrule harmony {
  class front = ["e", "i", "ö", "ü"]
  class back  = ["a", "ı", "o", "u"]
  class V = front | back

  class high = ["i", "ı", "u", "ü"]
  class low  = ["e", "a", "ö", "o"]

  class back_unrounded = ["a", "ı"]
  class back_rounded   = ["o", "u"]
  class front_rounded  = ["ö", "ü"]

  # --- Low vowels: 2-way (front → back) ---
  map to_back_low = c -> match {
    "e" -> "a",
    "ö" -> "a",
    else -> c
  }
  low -> to_back_low / back !V* + !V* _

  # --- High vowels: 4-way ---
  map to_back_unrounded_high = c -> match {
    "i" -> "ı", "ü" -> "ı", "u" -> "ı", else -> c
  }
  map to_back_rounded_high = c -> match {
    "i" -> "u", "ı" -> "u", "ü" -> "u", else -> c
  }
  map to_front_rounded_high = c -> match {
    "i" -> "ü", "ı" -> "ü", "u" -> "ü", else -> c
  }

  high -> to_back_unrounded_high / back_unrounded !V* + !V* _
  high -> to_back_rounded_high / back_rounded !V* + !V* _
  high -> to_front_rounded_high / front_rounded !V* + !V* _
}

# Vowel elision: drop suffix-initial vowel when stem ends in a vowel
phonrule elision {
  class V = ["a", "e", "ı", "i", "o", "ö", "u", "ü"]

  # Delete a vowel at the start of a suffix when immediately preceded by a vowel
  V -> null / V + _
}

# ---------------------------------------------------------------------------
# Inflection classes
# ---------------------------------------------------------------------------

# Verb conjugation — compose body with mixed eager + lazy `matching` slots.
#
# Layout `lazy* eager* lazy*`: a leading variadic catch-all for proclitics,
# the contiguous eager block (root + neg + tense + person/number), and a
# trailing catch-all for enclitics.
#
# NOTE on phonrule wrapping: `compose harmony(elision(...))` wraps the entire
# affix chain in two phonrules so surface forms become `yazıyorum` instead of
# `yaziyorum`. With any-lazy slots in the chain, phonrule application is
# deferred to render-time assembly (Phase 4). Pre-Phase-4, render does not
# attempt to assemble these forms; this body emits no `forms` rows in compile
# (forms emission for any-lazy bodies is Phase 7) and any `.hut` reference
# with plain `[axes]` will fail to resolve with a clean "no form" message.
inflection verb_conj for {tense, person, number, negation} {
  requires stems: root

  compose harmony(elision(proclitics* + root + neg_sfx? + tense_sfx + pn_sfx? + enclitics*))

  slot neg_sfx   matching [negation, tense]
  slot tense_sfx matching [tense]
  slot pn_sfx    matching [tense, person, number]
  slot proclitics matching *
  slot enclitics  matching *
}

# Affix entries — inflectionless, plain `headword` + `tags` + `meaning`.
# They emit one `forms` row each and the slot's `matching [...]` filter is
# what selects them at render time. The grammar's lazy filter does the
# selection — there is no `is_morpheme` flag any more.
# Empty cells (e.g. negation=pos, person=3 number=sg) need no entry.

# --- negation morphemes (vary by tense) ---
entry neg_pc {
  headword: "mi"
  tags: [negation=neg, tense=present_cont]
  meaning: "negation, present continuous"
}

entry neg_pst {
  headword: "me"
  tags: [negation=neg, tense=past]
  meaning: "negation, past"
}

# --- tense morphemes ---
entry tns_pc {
  headword: "iyor"
  tags: [tense=present_cont]
  meaning: "present continuous"
}

entry tns_pst {
  headword: "di"
  tags: [tense=past]
  meaning: "past"
}

# --- person/number morphemes (present continuous) ---
entry pn_pc_1sg {
  headword: "um"
  tags: [tense=present_cont, person=1, number=sg]
  meaning: "1sg present continuous"
}

entry pn_pc_2sg {
  headword: "sun"
  tags: [tense=present_cont, person=2, number=sg]
  meaning: "2sg present continuous"
}

# 3sg present_cont is zero — no morpheme entry.

entry pn_pc_1pl {
  headword: "uz"
  tags: [tense=present_cont, person=1, number=pl]
  meaning: "1pl present continuous"
}

entry pn_pc_2pl {
  headword: "sunuz"
  tags: [tense=present_cont, person=2, number=pl]
  meaning: "2pl present continuous"
}

entry pn_pc_3pl {
  headword: "lar"
  tags: [tense=present_cont, person=3, number=pl]
  meaning: "3pl present continuous"
}

# --- person/number morphemes (past) ---
entry pn_pst_1sg {
  headword: "m"
  tags: [tense=past, person=1, number=sg]
  meaning: "1sg past"
}

entry pn_pst_2sg {
  headword: "n"
  tags: [tense=past, person=2, number=sg]
  meaning: "2sg past"
}

# 3sg past is zero — no morpheme entry.

entry pn_pst_1pl {
  headword: "k"
  tags: [tense=past, person=1, number=pl]
  meaning: "1pl past"
}

entry pn_pst_2pl {
  headword: "niz"
  tags: [tense=past, person=2, number=pl]
  meaning: "2pl past"
}

entry pn_pst_3pl {
  headword: "ler"
  tags: [tense=past, person=3, number=pl]
  meaning: "3pl past"
}

# Unified noun declension with vowel harmony
inflection noun_decl for {number, case} {
  requires stems: root

  compose harmony(root + plural_sfx + case_sfx)

  slot plural_sfx {
    [number=sg, _] -> ``
    [number=pl, _] -> `ler`
  }

  slot case_sfx {
    [case=nom, _] -> ``
    [case=acc, _] -> `i`
    [case=dat, _] -> `e`
    [case=gen, _] -> `in`
    [case=loc, _] -> `de`
    [case=abl, _] -> `den`
  }
}
